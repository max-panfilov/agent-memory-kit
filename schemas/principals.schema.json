{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["principals"],
  "additionalProperties": false,
  "properties": {
    "principals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["client_id", "token_sha256", "scopes", "projects", "applications"],
        "additionalProperties": false,
        "properties": {
          "client_id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,120}$"},
          "token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "enum": ["memory:read", "memory:write"]}
          },
          "projects": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 1}
          },
          "applications": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"pattern": "^[1-9][0-9]*$"},
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-zA-Z0-9_.:/-]{1,120}$"}
            }
          }
        }
      }
    }
  }
}
