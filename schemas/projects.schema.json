{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["projects"],
  "additionalProperties": false,
  "properties": {
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "repository", "aliases", "applications"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1, "maxLength": 120},
          "repository": {"type": "string", "pattern": "^[a-z0-9_.-]+/[a-z0-9_.-]+$"},
          "aliases": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 120}, "uniqueItems": true},
          "applications": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name", "required_documents", "reference_documents"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "pattern": "^[a-zA-Z0-9_.:/-]{1,120}$"},
                "name": {"type": "string", "minLength": 1, "maxLength": 120},
                "required_documents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "reference_documents": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              }
            }
          }
        }
      }
    }
  }
}
