{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["documents"],
  "additionalProperties": false,
  "properties": {
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "version", "kind", "status", "sha256", "path", "profiles", "source_refs", "review_due"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_.:-]{1,120}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "kind": {"type": "string", "enum": ["standard", "pattern", "project-guide", "research", "case", "business-context", "infrastructure"]},
          "status": {"type": "string", "enum": ["approved", "observed", "draft", "deprecated"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "path": {"type": "string", "pattern": "^(?!.*\\.\\.)[a-zA-Z0-9_./-]+$"},
          "profiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "source_refs": {"type": "array", "items": {"type": "object"}},
          "review_due": {"type": "string", "format": "date"},
          "source_repository": {"type": "string"},
          "approval": {
            "type": "object",
            "required": ["reviewer", "reviewed_at", "review_ref", "content_sha256"],
            "additionalProperties": false,
            "properties": {
              "reviewer": {"type": "string", "minLength": 1},
              "reviewed_at": {"type": "string", "format": "date-time"},
              "review_ref": {"type": "string", "minLength": 1},
              "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  }
}
